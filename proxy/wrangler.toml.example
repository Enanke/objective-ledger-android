# Cloudflare Worker 配置示例。
# 复制为 wrangler.toml 并部署。以下两个 Secret 绝不写进本文件或仓库：
#   wrangler secret put DEEPSEEK_API_KEY   # DeepSeek 密钥
#   wrangler secret put ACCESS_TOKEN       # 代理访问令牌（随机长字符串，供 App 运行时输入）
name = "award-ledger-proxy"
main = "worker.js"
compatibility_date = "2024-11-01"

# 可选：自定义域名/路由（务必使用 HTTPS，不要开放为公开代理）
# routes = [{ pattern = "proxy.example.com/v1/*", zone_name = "example.com" }]

[observability]
enabled = true
